# This bot is designed for one household: a single arr stack shared by every
# Telegram ID in ALLOWED_USER_IDS. It is not multi-tenant — it does not
# support multiple independent arr stacks from one running instance.
#
# Required vars are grouped first. Everything below "Optional Features" can
# be left unset; the corresponding feature is simply disabled.

# --- Telegram Bot Configuration (required) ---
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Security
# Comma-separated list of Telegram User IDs allowed to interact with the bot.
# Use @userinfobot or similar to find your ID.
ALLOWED_USER_IDS=your_user_id_here

# --- AI Configuration (required) ---
# Options: google, ollama, anthropic
AI_PROVIDER=google
# For Anthropic (Claude) — official Anthropic SDK. Set AI_MODEL_FAST /
# AI_MODEL_CAPABLE to Claude model IDs; claude-haiku-5-5 for both is the measured
# recommendation (specs/2026-11-20-claude-provider/). Unset = claude-opus-5-5.
# AI_MODEL_FALLBACKS does not apply (the SDK retries 429s; refusals use
# server-side fallbacks on Opus/Sonnet). Voice notes still need TRANSCRIPTION_URL
# or GOOGLE_GENERATIVE_AI_API_KEY — Claude does not take audio.
ANTHROPIC_API_KEY=
# For Google Gemini (Gemini 2.0 Flash is recommended)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
# For Ollama (local or cloud) — this is also the generic OpenAI-compatible path:
# point OLLAMA_BASE_URL at any OpenAI-compatible host and put its key in
# OLLAMA_API_KEY ("/v1" is appended automatically).
# Local:  http://127.0.0.1:11434  (default)
# Groq:   https://api.groq.com/openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# API key for a hosted OpenAI-compatible endpoint (not needed for local Ollama).
OLLAMA_API_KEY=

# --- Token budget (optional) ---
# Hosted free tiers cap tokens per minute. The bot already sends only the tools
# and prompt sections a message needs (src/agent/toolRouter.ts); these tune the rest.
# Characters of past conversation sent per request (~4 chars per token). Default 4000.
AI_HISTORY_CHAR_BUDGET=
# Comma-separated models to switch to when the current one hits its daily quota
# (a 429 asking to wait more than a minute). Each model has its own quota.
AI_MODEL_FALLBACKS=
# Sent as "reasoning_effort" on chat requests (e.g. low) for reasoning models.
# With AI_PROVIDER=anthropic it is Claude's output_config.effort:
# low | medium | high | xhigh | max (unset = model default).
AI_REASONING_EFFORT=

# --- AI Model Overrides (optional) ---
# Override the default model name used for each tier. Unset = provider default.
AI_MODEL=
AI_MODEL_CAPABLE=
AI_MODEL_FAST=

# --- Service URLs & API Keys (required) ---
# Default local URLs are provided. Update if your services run elsewhere.

RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key_here

SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_api_key_here

QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_qbittorrent_password_here

NZBGET_URL=http://localhost:6789
NZBGET_USERNAME=admin
NZBGET_PASSWORD=nzbget_password

PLEX_URL=http://localhost:32400
# To find your Plex token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your_plex_token_here
# Comma-separated list of section IDs (found via /status or setup script)
PLEX_MOVIE_SECTION_IDS=1
PLEX_SHOW_SECTION_IDS=2

ERSATZTV_URL=http://localhost:8409
ERSATZTV_API_KEY=

# --- TMDB (optional) ---
# Powers discoverMedia recommendations. Unset disables the feature only —
# the bot still runs normally without it.
TMDB_READ_ACCESS_TOKEN=
TMDB_READ_API_KEY=

# --- Voice Transcription (optional) ---
# Whisper-compatible fallback chain for transcribing Telegram voice messages,
# independent of AI_PROVIDER. Resolution order: TRANSCRIPTION_URL (explicit)
# > AI_PROVIDER-derived endpoint (Ollama/Gemini) > OPENAI_* as a last resort.
TRANSCRIPTION_URL=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Webhook Server (optional) ---
# Set to 'true' to receive real-time Plex/Radarr/Sonarr/qBittorrent/NZBGet
# notifications instead of relying on polling.
USE_PLEX_WEBHOOK=false
WEBHOOK_PORT=3000
# Overrides fan-out: by default every ID in ALLOWED_USER_IDS is notified.
WEBHOOK_NOTIFY_CHAT_ID=

# --- Proxy Gateway (optional, split-deployment only) ---
# Set to 'true' on the Brain (VPS) to route API calls through the Proxy
USE_PROXY=false
# The Tailscale IP and port of the Home PC running the proxy (e.g., http://100.x.x.x:3001)
PROXY_URL=
# A secure, randomly generated string shared between Brain and Proxy
PROXY_SECRET_KEY=
# Set this ON THE PROXY (Home PC) to forward raw webhooks up to the Brain (VPS)
# Example: http://100.y.y.y:3000 (The VPS Tailscale IP + WEBHOOK_PORT)
BRAIN_WEBHOOK_URL=
# Port the Proxy Gateway listens on (set on the Home PC running the proxy)
PROXY_PORT=3001
# Auth token for the proxy's /api/* dashboard routes. Unset = open to anyone
# on the network the proxy is reachable from.
DASHBOARD_TOKEN=

# --- Misc (optional) ---
# Override the command used to restart the bot service (e.g. for non-systemd setups)
BOT_RESTART_COMMAND=
