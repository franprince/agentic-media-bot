{
  "name": "agentic-media-bot",
  "version": "4.42.1",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "verify": "bun src/verify-config.ts",
    "dev": "bun run --watch src/bot.ts",
    "proxy": "bun run src/proxy.ts",
    "proxy:ui:dev": "cd proxy-ui && bun run dev",
    "proxy:ui:build": "cd proxy-ui && bun run build",
    "check:bot-parse": "bun build src/bot.ts --target bun --outfile /tmp/bot-parse-check.js",
    "test": "bun test",
    "test:bot": "bun test src/",
    "test:ui": "cd proxy-ui && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.3.0",
    "@types/node-cron": "^3.0.11",
    "msw": "^2.12.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/google": "^0.0.52",
    "@ai-sdk/openai": "^0.0.60",
    "@grammyjs/runner": "^2.0.3",
    "ai": "^3.4.33",
    "grammy": "^1.40.0",
    "node-cron": "^4.2.1",
    "ollama-ai-provider": "^1.2.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1"
  }
}